{
  "openapi": "3.0.3",
  "info": {
    "title": "Lisan.ai API",
    "version": "1.0.0",
    "description": "API untuk platform penilaian lisan berbasis AI: autentikasi, manajemen assessment/kelas/user, evaluasi AI, observability, dan penelitian (research harness).\n\n## Autentikasi\n\nSebagian besar endpoint memakai sesi cookie (HttpOnly) yang dibuat via `POST /api/auth`.\n\nUntuk integrasi sistem eksternal, endpoint **Public API** (`/api/v1/*`) dan **Aksi AI** (`/api/assessment`) mendukung autentikasi alternatif menggunakan **API Key** pada header:\n\n```\nAuthorization: Bearer lsk_xxx\n```\n\nAPI key (prefix `lsk_`) dapat dibuat oleh admin di halaman **Akun → API Keys**. API key tidak memerlukan CSRF token.\n\n## CSRF\nPermintaan POST yang memakai sesi browser (cookie) wajib menyertakan header `X-CSRF-Token` berisi `csrfToken` dari `GET /api/auth?action=me` atau hasil login/register."
  },
  "servers": [
    { "url": "https://lisan-ai-assessment.vercel.app", "description": "Production (Vercel)" },
    { "url": "http://127.0.0.1:4173", "description": "Local development" }
  ],
  "security": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "lsk_",
        "description": "API key dengan prefix `lsk_`. Contoh: `Authorization: Bearer lsk_xxx`"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "Session",
        "description": "Session cookie (HttpOnly) yang diatur oleh `POST /api/auth` (login/register)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Unauthorized" }
        }
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true }
        }
      },
      "Authenticated": {
        "type": "object",
        "properties": {
          "authenticated": { "type": "boolean", "example": true },
          "tenant": { "$ref": "#/components/schemas/Tenant" },
          "user": { "$ref": "#/components/schemas/User" },
          "csrfToken": { "type": "string", "description": "CSRF token untuk request POST berbasis sesi" }
        }
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "plan": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tenantId": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "teacher", "student"] }
        }
      },
      "ActionRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "description": "Nama aksi yang diminta" },
          "payload": { "type": "object", "description": "Data aksi" },
          "id": { "type": "string", "description": "ID target (dipakai sebagian aksi)" }
        }
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "topic": { "type": "string" },
          "difficulty": { "type": "string" },
          "status": { "type": "string", "enum": ["published", "closed"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Submission": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "assessment_id": { "type": "string" },
          "student_name": { "type": "string" },
          "final_score": { "type": "integer" },
          "submitted_at": { "type": "string", "format": "date-time" }
        }
      },
      "Class": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "joinCode": { "type": "string", "description": "Kode gabung 8 karakter" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "GenerateRequest": {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "topic": { "type": "string", "description": "Topik atau materi assessment" },
          "outcomes": { "type": "string", "description": "Kompetensi / capaian pembelajaran" },
          "rubric": { "type": "string", "description": "Rubrik penilaian" },
          "difficulty": { "type": "string", "enum": ["Dasar", "Menengah", "Lanjutan"], "default": "Menengah" },
          "count": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5, "description": "Jumlah soal" },
          "examples": { "type": "string", "description": "Contoh soal opsional" }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "focus": { "type": "string" },
          "outcome": { "type": "string" },
          "rubric": { "type": "string" },
          "ideal": { "type": "string" }
        }
      },
      "EvaluateRequest": {
        "type": "object",
        "required": ["assessment", "answers"],
        "properties": {
          "assessment": {
            "type": "object",
            "description": "Objek assessment (bisa dari hasil generate atau buatan sendiri)",
            "properties": {
              "id": { "type": "string" },
              "topic": { "type": "string" },
              "rubric": { "type": "string", "description": "Rubrik penilaian" },
              "outcomes": { "type": "string" },
              "oralExamEnabled": { "type": "boolean", "default": true, "description": "true = penilaian ujian lisan (tidak menghukum format tulisan)" },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prompt": { "type": "string" },
                    "outcome": { "type": "string" },
                    "rubric": { "type": "string" }
                  }
                }
              }
            }
          },
          "answers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Jawaban siswa, satu per soal (urutan sama dengan questions)"
          },
          "studentName": { "type": "string" }
        }
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "finalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "feedback": { "type": "string" },
          "questionScores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": { "type": "string" },
                "answer": { "type": "string" },
                "score": { "type": "integer" },
                "matched": { "type": "array", "items": { "type": "string" } },
                "strengths": { "type": "array", "items": { "type": "string" } },
                "gaps": { "type": "array", "items": { "type": "string" } },
                "complaint": {
                  "type": "object",
                  "description": "Komplain siswa pada soal (jika ada)",
                  "properties": {
                    "reason": { "type": "string" },
                    "status": { "type": "string", "enum": ["pending"] },
                    "submittedAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      },
      "RecommendRequest": {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "topic": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["Dasar", "Menengah", "Lanjutan"], "default": "Menengah" }
        }
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "outcomes": { "type": "string" },
          "rubric": { "type": "string" }
        }
      },
      "SSEEvent": {
        "type": "object",
        "description": "Event Server-Sent Events. Tipe: `chunk` (teks inkremental), `result` (hasil akhir), `error`.",
        "properties": {
          "type": { "type": "string", "enum": ["chunk", "result", "error"] },
          "text": { "type": "string" },
          "data": { "type": "object" },
          "message": { "type": "string" }
        }
      },
      "ApiKeyCreateResponse": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "description": "Raw API key (hanya ditampilkan sekali)" },
          "keyId": { "type": "string" },
          "name": { "type": "string" },
          "prefix": { "type": "string" }
        }
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "prefix": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "revokedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ObservabilityResponse": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object",
            "properties": {
              "totalCalls": { "type": "integer" },
              "errorRate": { "type": "integer" },
              "retryRate": { "type": "integer" },
              "avgLatencyMs": { "type": "integer" },
              "p50LatencyMs": { "type": "integer" },
              "p95LatencyMs": { "type": "integer" },
              "p99LatencyMs": { "type": "integer" },
              "promptTokens": { "type": "integer" },
              "completionTokens": { "type": "integer" },
              "totalTokens": { "type": "integer" },
              "actualCostUSD": { "type": "number" },
              "savedCostUSD": { "type": "number" },
              "cacheEfficiencyPercent": { "type": "integer" }
            }
          },
          "modelUsage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model": { "type": "string" },
                "calls": { "type": "integer" }
              }
            }
          },
          "system": {
            "type": "object",
            "properties": {
              "uptimeSeconds": { "type": "integer" },
              "nodeVersion": { "type": "string" },
              "memoryHeapUsedMB": { "type": "integer" },
              "memoryRssMB": { "type": "integer" }
            }
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "action": { "type": "string" },
                "model": { "type": "string" },
                "latencyMs": { "type": "integer" },
                "status": { "type": "string" },
                "cost_usd": { "type": "number" },
                "created_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "ResearchRuns": {
        "type": "object",
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "run_id": { "type": "string" },
                "assessment_id": { "type": "string" },
                "submission_id": { "type": "string" },
                "model": { "type": "string" },
                "final_score": { "type": "integer" },
                "verification_valid": { "type": "boolean" },
                "created_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "SaveHumanScoreRequest": {
        "type": "object",
        "required": ["runId", "humanScore", "humanFeedback"],
        "properties": {
          "runId": { "type": "string" },
          "humanScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "humanFeedback": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/assessments": {
      "get": {
        "summary": "Daftar assessment",
        "description": "Mengembalikan daftar assessment milik tenant (Public API).",
        "tags": ["Public API · Assessments"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Daftar assessment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "assessments": { "type": "array", "items": { "$ref": "#/components/schemas/Assessment" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/submissions": {
      "get": {
        "summary": "Daftar submission",
        "description": "Mengembalikan daftar submission milik tenant (Public API).",
        "tags": ["Public API · Submissions"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Daftar submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "submissions": { "type": "array", "items": { "$ref": "#/components/schemas/Submission" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/assessments/generate": {
      "post": {
        "summary": "Generate soal (AI)",
        "description": "Membuat soal assessment lisan berdasarkan konfigurasi menggunakan AI (Public API).",
        "tags": ["Public API · Assessments"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Soal berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "questions": { "type": "array", "items": { "$ref": "#/components/schemas/Question" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/assessments/evaluate": {
      "post": {
        "summary": "Evaluasi jawaban",
        "description": "Menilai jawaban siswa berdasarkan rubrik menggunakan AI (Public API).",
        "tags": ["Public API · Assessments"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EvaluateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hasil evaluasi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "evaluation": { "$ref": "#/components/schemas/Evaluation" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/assessments/recommend": {
      "post": {
        "summary": "Rekomendasi konfigurasi (AI)",
        "description": "Membuat rekomendasi kompetensi (learning outcome) dan rubrik untuk topik tertentu (Public API).",
        "tags": ["Public API · Assessments"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecommendRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rekomendasi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recommendation": { "$ref": "#/components/schemas/Recommendation" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth": {
      "get": {
        "summary": "Ambil status autentikasi",
        "description": "Mengembalikan status sesi, user, tenant, dan CSRF token bila sudah login.",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["me", "simulation"], "default": "me" }
          }
        ],
        "responses": {
          "200": {
            "description": "Status autentikasi",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Authenticated" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Aksi autentikasi",
        "description": "Menjalankan aksi autentikasi. `register` (membuat tenant + admin), `login`, `logout`, atau `simulate-login` (hanya jika demo simulation diaktifkan).\n\nPermintaan `logout` berbasis sesi wajib menyertakan header `X-CSRF-Token`.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "enum": ["register", "login", "logout", "simulate-login"] },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "tenantName": { "type": "string" },
                      "name": { "type": "string" },
                      "email": { "type": "string", "format": "email" },
                      "password": { "type": "string" },
                      "userId": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil login / logout",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Authenticated" }
              }
            }
          },
          "201": {
            "description": "Berhasil register",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Authenticated" }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/database": {
      "get": {
        "summary": "Ambil data tenant",
        "description": "Mengambil kondisi data aplikasi berdasarkan role. Aksi `state` (semua terautentikasi) atau `users` (admin saja).",
        "tags": ["Database"],
        "security": [{ "sessionAuth": [] }],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["state", "users"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Data kondisi aplikasi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "summary": "Aksi CRUD data",
        "description": "Semua operasi tulis data (assessment, kelas, membership, user, submission, complaint). Role yang diizinkan bervariasi per aksi.\n\nAksi yang tersedia:\n- `clear-data` (guru/admin)\n- `save-assessment`, `update-assessment`, `delete-assessment` (guru/admin)\n- `save-submission` (siswa untuk dirinya; guru/admin untuk siswa)\n- `submit-complaint` (siswa)\n- `create-class`, `update-class`, `delete-class` (guru/admin)\n- `join-class` (siswa), `approve-membership`, `update-membership`, `delete-membership` (guru)\n- `create-user`, `create-users-batch`, `update-user`, `delete-user` (admin)\n- `add-students-to-class`, `create-students-batch` (guru)",
        "tags": ["Database"],
        "security": [{ "sessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ActionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil (bisa `ok`, `assessment`, `submission`, `class`, `user`, `added`/`errors`, dst.)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "assessment": { "$ref": "#/components/schemas/Assessment" },
                    "submission": { "$ref": "#/components/schemas/Submission" },
                    "class": { "$ref": "#/components/schemas/Class" },
                    "user": { "$ref": "#/components/schemas/User" },
                    "added": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": { "id": { "type": "string" }, "email": { "type": "string" } }
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": { "email": { "type": "string" }, "message": { "type": "string" } }
                      }
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Sumber daya berhasil dibuat",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/assessment": {
      "post": {
        "summary": "Aksi AI assessment (non-streaming & SSE)",
        "description": "Menjalankan aksi AI. Mendukung autentikasi sesi **atau** API key. Jika body berisi `stream: true`, respons berupa Server-Sent Events (SSE) `text/event-stream`.\n\nAksi non-streaming:\n- `generate-questions` (guru/admin)\n- `improve-questions` (guru/admin)\n- `recommend-assessment-config` (guru/admin)\n- `evaluate` (siswa/guru/admin)\n\nAksi streaming (SSE, `stream:true`):\n- `generate-questions`, `improve-questions`, `evaluate`, `recommend-assessment-config`",
        "tags": ["AI Assessment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["generate-questions", "improve-questions", "evaluate", "recommend-assessment-config"]
                  },
                  "stream": { "type": "boolean", "default": false },
                  "payload": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hasil aksi AI. Jika `stream:true`, berupa SSE.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "questions": { "type": "array", "items": { "$ref": "#/components/schemas/Question" } },
                    "evaluation": { "$ref": "#/components/schemas/Evaluation" },
                    "recommendation": { "$ref": "#/components/schemas/Recommendation" },
                    "model": { "type": "string" },
                    "harness": { "type": "boolean", "description": "true bila memakai harness evaluasi" }
                  }
                }
              },
              "text/event-stream": {
                "schema": { "$ref": "#/components/schemas/SSEEvent" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
