# Copy to .env and replace every placeholder. Never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
MAX_REQUEST_BODY_CHARS=20000000

# AI provider: application/database remain on-prem; inference is sent to OpenRouter.
HARNESS_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-real-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Local persistent SQLite/libSQL database in the named Docker volume.
TURSO_DATABASE_URL=file:/app/data/lisan_ai.db
TURSO_AUTH_TOKEN=

# Required production security secret: generate a cryptographically random value >=32 characters.
CSRF_SECRET=replace-with-at-least-32-random-characters

# LTI 1.1 — obtain the real values from the BINUS Maya LMS administrator.
LTI_PUBLIC_ORIGIN=https://lisanai.binus.ac.id
LTI_LAUNCH_URL=https://lisanai.binus.ac.id/api/lti
LTI_DEFAULT_REDIRECT_URL=/
LTI_TENANT_ID=replace-with-existing-bin-us-tenant-id
LTI_CONSUMERS_JSON={"replace-with-consumer-key":"replace-with-long-random-shared-secret"}
# Replace with the exact HTTPS origin(s) and outcome host(s) confirmed by BINUS Maya administrators.
LTI_FRAME_ANCESTORS=https://replace-with-exact-binus-maya-origin
LTI_OUTCOME_HOSTS=replace-with-exact-outcomes-service-host
