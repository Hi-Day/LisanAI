OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
PORT=4173
# HTTP-Referer sent to OpenRouter. Set to your production domain in deployment.
# OPENROUTER_REFERER=https://lisan-ai-assessment.vercel.app

# Trustworthy assessment harness (evidence verification, publication gate,
# reproducibility hashes, reliability vector). Harness is the default
# evaluation engine. Set HARNESS_EVALUATION=legacy to restore the legacy path.
HARNESS_EVALUATION=
# Harness AI provider: "mock" (deterministic, no API key) or "openrouter".
HARNESS_PROVIDER=openrouter
# Max model re-runs when verification FAILs (bounded retry, 0 = single attempt).
MAX_EVALUATION_RETRIES=1
# Demo simulation widget (dev convenience for switching between seeded users).
ENABLE_DEMO_SIMULATION=false
